generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  KOMITE_MUTU
  DIREKTUR
  PIC_UNIT
  DATA_COLLECTOR
  VALIDATOR
}

enum AnalysisStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  APPROVED
  REJECTED
}

/// Kategori indikator — extensible. Tambah value baru di sini saat ada jenis ke-3 (mis. INP).
enum IndicatorCategory {
  INM
  IMP
  IMP_RS
  IMK
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(DATA_COLLECTOR)
  nik          String?  @db.VarChar(32)
  gelar        String?  @db.VarChar(64)
  unitId       String?
  unit         Unit?    @relation(fields: [unitId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  analysesApproved   Analysis[] @relation("AnalysisApprovedBy")
  analysesValidated  Analysis[] @relation("AnalysisValidatedBy")
  auditLogs          AuditLog[]
  observations       Observation[]
  accounts           Account[]
  sessions           Session[]

  @@index([unitId])
  @@index([role])
}

model Unit {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  orderNo     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  indicators  Indicator[]
}

model Indicator {
  id                String           @id @default(cuid())
  unitId            String
  unit              Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  category          IndicatorCategory @default(INM)
  code              String
  title             String
  numeratorLabel    String
  denominatorLabel  String
  targetPct         Decimal          @db.Decimal(5, 2) @default(100.00)
  frequency         String           @default("DAILY")
  orderNo           Int              @default(0)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  observations Observation[]
  analyses     Analysis[]

  @@unique([category, unitId, code])
  @@index([unitId])
  @@index([category])
}

model Observation {
  id               String   @id @default(cuid())
  indicatorId      String
  indicator        Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  unitId           String
  observationDate  DateTime @db.Date
  numeratorValue   Int      @default(0)
  denominatorValue Int      @default(0)
  createdById      String
  createdByUser    User     @relation(fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([indicatorId, observationDate])
  @@index([unitId, observationDate])
}

model Analysis {
  id              String         @id @default(cuid())
  indicatorId     String
  indicator       Indicator      @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  unitId          String
  periodMonth     Int
  periodYear      Int
  analisaText     String?        @db.Text
  pdsaPlan        String?        @db.Text
  pdsaDo          String?        @db.Text
  pdsaStudy       String?        @db.Text
  pdsaAct         String?        @db.Text
  dataCollector   String?
  picName         String?
  picNik          String?        @db.VarChar(32)
  status          AnalysisStatus @default(DRAFT)
  submittedAt     DateTime?
  validatedAt     DateTime?
  validatedById   String?
  validatedBy     User?          @relation("AnalysisValidatedBy", fields: [validatedById], references: [id])
  validationNote  String?        @db.Text
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?          @relation("AnalysisApprovedBy", fields: [approvedById], references: [id])
  rejectionNote   String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([indicatorId, periodMonth, periodYear])
  @@index([unitId, periodYear, periodMonth])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Konfigurasi tampilan login (singleton — hanya 1 baris dengan id="singleton").
model SiteSetting {
  id                String   @id @default("singleton")
  // Branding atas form
  brandIcon         String   @default("Activity") // nama ikon Lucide
  brandTitle        String   @default("Sistem INM Rumah Sakit")
  brandSubtitle     String   @default("Royal Prima Jambi · Indikator Mutu Nasional")
  // Sisi kiri (image panel)
  sideImageUrl      String?  // URL gambar background; kosong = pakai gradient default
  sideBadge         String   @default("RS Royal Prima Jambi")
  sideHeadline      String   @default("Pemantauan Mutu Rumah Sakit")
  sideParagraph     String   @default("Sistem pemantauan Indikator Mutu Nasional dan Prioritas untuk menjamin pelayanan yang aman, efektif, dan bermutu bagi setiap pasien.")
  sideBullet1       String   @default("Indikator INM & IMP lintas unit")
  sideBullet2       String   @default("Dashboard real-time & analisa PDSA")
  sideBullet3       String   @default("Workflow approval Komite Mutu")
  // Sambutan di atas form login
  welcomeTitle      String   @default("Selamat datang") @db.VarChar(120)
  welcomeSubtitle   String   @default("Masuk untuk mengakses dashboard pemantauan mutu.") @db.VarChar(180)
  // Footer
  footerText        String   @default("© Tim Mutu RS Royal Prima Jambi")
  // Fitur input: batasi pengisian hanya N hari terakhir (true) atau semua tanggal (false)
  restrictEditWindow Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}
